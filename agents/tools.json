  {
    "name": "create_record",
    "description": "Create one validated record; do not retry an uncertain result without reconciliation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "record": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "task",
                "contact",
                "bid",
                "material",
                "permit",
                "check",
                "document",
                "decision",
                "contract",
                "payment",
                "hold",
                "review"
              ]
            },
            "project_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string"
            },
            "owner_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "due_date": {
              "type": [
                "string",
                "null"
              ],
              "description": "YYYY-MM-DD, or null to clear."
            },
            "data": {
              "type": "object",
              "description": "Kind-specific values. See live recordKinds. For updates these keys are merged into existing data; arrays replace as a whole."
            }
          },
          "required": [
            "kind",
            "title"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false
    }
  },
