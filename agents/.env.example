# Load these in the agent host. Never commit the filled copy.
# For renewable setup: PM_AGENT_EMAIL and PM_AGENT_PASSWORD are supplied
# privately only to scripts/agent-login.mjs; they are not saved in the connection.
# Optional per-agent override (otherwise ~/.config/rockwood-projects/connection.json):
# PM_AGENT_CONNECTION_FILE=/private/path/connection.json
PM_AGENT_BASE_URL=https://rockwood-projects.vercel.app
PM_AGENT_WORKSPACE_ID=
PM_AGENT_ACCESS_TOKEN=
# Alternative to PM_AGENT_ACCESS_TOKEN: private JSON containing access_token.
PM_AGENT_TOKEN_FILE=
# Required only for private uploads. Must match the target app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
