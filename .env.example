NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cam capture uses the same public Supabase configuration above.
# Activate processing only after the companion Lambda connection is installed.
AI_PROVIDER=aws
AWS_PROCESSING_ENABLED=false
LIVE_AI_ENABLED=false
ROCKWOOD_AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
AWS_ROLE_ARN=
ALLOWED_ORIGINS=http://localhost:8792,http://127.0.0.1:8792
# Lambda-only credentials belong in its existing Secrets Manager secret, never here.
